# ── 数据库（唯一配置来源，不接受命令行参数） ─────────────────────────────
EASYTIER_DB_DRIVER=sqlite            # sqlite | postgres
EASYTIER_DB_DSN=/var/lib/easytier/et.db
# EASYTIER_DB_DSN=postgres://easytier:secret@db:5432/easytier?sslmode=disable
EASYTIER_DB_MAX_OPEN=16
EASYTIER_DB_MAX_IDLE=4
EASYTIER_DB_CONN_LIFETIME=1800
EASYTIER_DB_AUTO_ALIGN=1             # 启动时对齐声明式 Schema
EASYTIER_DB_ALIGN_DRYRUN=0           # 1 = 只报告差异，不改结构
EASYTIER_DB_BACKUP=1                 # 对齐前快照（SQLite 复制文件）
EASYTIER_DB_BACKUP_DIR=./backups
# EASYTIER_DB_BACKUP_CMD=pg_dump --schema-only

# ── OIDC（全部设置后登录页出现 SSO 按钮） ───────────────────────────────
# EASYTIER_OIDC_ISSUER=https://id.example.com
# EASYTIER_OIDC_CLIENT_ID=easytier-console
# EASYTIER_OIDC_CLIENT_SECRET=...
# EASYTIER_OIDC_REDIRECT_URL=https://console.example.com/api/v1/auth/oidc/callback
# EASYTIER_OIDC_SCOPES=openid profile email
# EASYTIER_OIDC_BUTTON_LABEL=使用企业账号登录
# EASYTIER_OIDC_ALLOW_INSECURE=0     # 1 仅用于 http 本地开发
